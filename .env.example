# EMO-AVENTURA · variables de entorno
#
# Copia este archivo como `.env` y rellena los valores. El `.env` NUNCA se
# sube al repositorio (esta en .gitignore).
#
# Si estas variables faltan, el juego funciona igual: no se registran
# estadisticas y el panel de administracion avisa de que falta configurarlo.

# URL del proyecto de Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Clave publica "anon" de Supabase (Project Settings -> API -> anon public).
# Es la UNICA clave que puede ir en el frontend. La clave `service_role`
# jamas se escribe aqui ni en el codigo.
VITE_SUPABASE_ANON_KEY=

# Correo del unico administrador que puede entrar al panel
VITE_ADMIN_EMAIL=maicolpoveda115@gmail.com

# Opcional: registrar estadisticas tambien durante el desarrollo (pnpm dev).
# Por defecto NO se registra nada en desarrollo para no ensuciar los datos.
VITE_TRACK_DEV=false
